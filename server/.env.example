DATABASE_URL=postgresql://user:pass@localhost:5432/datlt
JWT_SECRET=replace-with-a-long-random-secret
PORT=8080
NODE_ENV=development
# The first administrator, used only when the seed actually creates one. These defaults are
# the published demo credentials: fine locally, and refused when seeding a production
# database.
SEED_ADMIN_EMAIL=ops@dat-lt.aero
SEED_ADMIN_PASSWORD=CommandCenter2026!
# Comma-separated extra browser origins allowed to call the API.
# Unset: same-origin only in production, permissive in development.
CORS_ORIGINS=
# How a self-service password reset is delivered. 'none' turns the feature off and leaves
# admin reset as the way back into an account. 'log' writes the link to the server log for
# local development, and is refused in production. There is no SMTP transport yet.
MAIL_TRANSPORT=none
# Base URL reset links point at. Unset is fine when the API serves the SPA.
PUBLIC_URL=
